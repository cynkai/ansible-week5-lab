---
exclude_paths:
  - collections/
  - galaxy_roles/
  - week4_recheck.yml
  - leak_path.yml
  - vault_test.yml
  - label_test.yml
  - orch_test.yml
  - orch_order.yml
  - orch_ctrl.yml
  - orch_fail_false.yml
  - orch_fail_true.yml
  - import_test.yml
  - include_test.yml
  - include_apply_test.yml
skip_list:
  - yaml[comments]        # galaxy 자동생성 주석
  - var-naming[no-role-prefix]  # app_version은 역할 공유 변수로 의도된 것
